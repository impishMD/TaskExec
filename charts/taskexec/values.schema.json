{
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "nameOverride": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 58
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
            "maxLength": 253
          }
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^/"
                    },
                    "pathType": {
                      "type": "string",
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "pathType"
                  ]
                },
                "minItems": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "host",
              "paths"
            ]
          },
          "minItems": 1
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                "maxLength": 253
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "secretName",
              "hosts"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "properties": {
        "existingClaim": {
          "type": "string"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "storageClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessModes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadWriteOncePod"
            ]
          },
          "minItems": 1,
          "maxItems": 1
        },
        "retain": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "volumePermissions": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "not": {
          "enum": [
            "checksum/config"
          ]
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "runAsUser",
        "runAsGroup"
      ]
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "startupProbe": {
      "type": "object",
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold"
      ]
    },
    "readinessProbe": {
      "type": "object",
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold"
      ]
    },
    "livenessProbe": {
      "type": "object",
      "properties": {
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold"
      ]
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "accesskeyEncryptionKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "existingSecret"
      ]
    },
    "admin": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "fullname": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "passwordKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^[^:\\s]*$"
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "type": {
          "type": "string",
          "enum": [
            "sqlite",
            "postgres",
            "mysql"
          ]
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "usernameKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "minLength": 1
        },
        "passwordKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "postgres",
                  "mysql"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "general": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^$|^https?://[^/?#@\\s]+(/[^?#\\s]*)?$"
        },
        "passwordLoginDisable": {
          "type": "boolean"
        },
        "nonAdminCanCreateProject": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "properties": {
        "forwarded_env_vars": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "extraEnvVariables": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "allOf": [
          {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          {
            "not": {
              "enum": [
                "TASKEXEC_INTERFACE",
                "TASKEXEC_PORT",
                "TASKEXEC_CONFIG_PATH",
                "TASKEXEC_DB_PATH",
                "TASKEXEC_TMP_PATH",
                "TASKEXEC_WEB_ROOT",
                "TASKEXEC_ADMIN",
                "TASKEXEC_ADMIN_NAME",
                "TASKEXEC_ADMIN_EMAIL",
                "TASKEXEC_ADMIN_PASSWORD",
                "TASKEXEC_ACCESS_KEY_ENCRYPTION",
                "TASKEXEC_DB_DIALECT",
                "TASKEXEC_DB_OPTIONS",
                "TASKEXEC_DB_HOST",
                "TASKEXEC_DB_PORT",
                "TASKEXEC_DB",
                "TASKEXEC_DB_USER",
                "TASKEXEC_DB_PASS",
                "TASKEXEC_OIDC_PROVIDERS",
                "TASKEXEC_PASSWORD_LOGIN_DISABLED",
                "TASKEXEC_NON_ADMIN_CAN_CREATE_PROJECT",
                "TASKEXEC_FORWARDED_ENV_VARS",
                "SSL_CERT_FILE",
                "REQUESTS_CA_BUNDLE",
                "GIT_SSL_CAINFO"
              ]
            }
          }
        ]
      }
    },
    "extraEnvSecrets": {
      "type": "object",
      "propertyNames": {
        "allOf": [
          {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          {
            "not": {
              "enum": [
                "TASKEXEC_INTERFACE",
                "TASKEXEC_PORT",
                "TASKEXEC_CONFIG_PATH",
                "TASKEXEC_DB_PATH",
                "TASKEXEC_TMP_PATH",
                "TASKEXEC_WEB_ROOT",
                "TASKEXEC_ADMIN",
                "TASKEXEC_ADMIN_NAME",
                "TASKEXEC_ADMIN_EMAIL",
                "TASKEXEC_ADMIN_PASSWORD",
                "TASKEXEC_ACCESS_KEY_ENCRYPTION",
                "TASKEXEC_DB_DIALECT",
                "TASKEXEC_DB_OPTIONS",
                "TASKEXEC_DB_HOST",
                "TASKEXEC_DB_PORT",
                "TASKEXEC_DB",
                "TASKEXEC_DB_USER",
                "TASKEXEC_DB_PASS",
                "TASKEXEC_OIDC_PROVIDERS",
                "TASKEXEC_PASSWORD_LOGIN_DISABLED",
                "TASKEXEC_NON_ADMIN_CAN_CREATE_PROJECT",
                "TASKEXEC_FORWARDED_ENV_VARS",
                "SSL_CERT_FILE",
                "REQUESTS_CA_BUNDLE",
                "GIT_SSL_CAINFO"
              ]
            }
          }
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
            "maxLength": 253
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "secret",
          "key"
        ]
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "not": {
          "enum": [
            "app.kubernetes.io/name",
            "app.kubernetes.io/instance",
            "app.kubernetes.io/component",
            "app.kubernetes.io/version",
            "app.kubernetes.io/managed-by",
            "helm.sh/chart"
          ]
        }
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "not": {
          "enum": [
            "checksum/config"
          ]
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "dnsConfig": {
      "type": "object"
    },
    "extraInitContainers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraSidecarContainers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "envFromSecrets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
        "maxLength": 253
      },
      "uniqueItems": true
    },
    "envFromConfigMaps": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
        "maxLength": 253
      },
      "uniqueItems": true
    },
    "customCertificates": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "existingConfigMap": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "existingSecret": {
                    "minLength": 1
                  },
                  "existingConfigMap": {
                    "const": ""
                  }
                }
              },
              {
                "properties": {
                  "existingConfigMap": {
                    "minLength": 1
                  },
                  "existingSecret": {
                    "const": ""
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "oidc": {
      "type": "object",
      "properties": {
        "enable": {
          "type": "boolean"
        },
        "providers": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 48
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "displayName": {
                "type": "string",
                "minLength": 1
              },
              "providerUrl": {
                "type": "string",
                "pattern": "^https?://[^\\s]+$"
              },
              "clientId": {
                "type": "string",
                "minLength": 1
              },
              "existingSecret": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                "maxLength": 253
              },
              "clientSecretKey": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "minLength": 1
              },
              "clientIdKey": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$",
                "minLength": 1
              },
              "redirectUrl": {
                "type": "string",
                "pattern": "^https?://[^\\s]+$"
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "contains": {
                  "const": "openid"
                },
                "uniqueItems": true
              },
              "order": {
                "type": "integer"
              },
              "returnViaState": {
                "type": "boolean"
              },
              "requireVerifiedEmail": {
                "type": "boolean"
              },
              "usernameClaim": {
                "type": "string",
                "minLength": 1
              },
              "nameClaim": {
                "type": "string",
                "minLength": 1
              },
              "emailClaim": {
                "type": "string",
                "minLength": 1
              },
              "color": {
                "type": "string",
                "minLength": 1
              },
              "icon": {
                "type": "string",
                "minLength": 1
              },
              "endpoint": {
                "type": "object",
                "properties": {
                  "issuerUrl": {
                    "type": "string",
                    "pattern": "^https?://[^\\s]+$"
                  },
                  "authUrl": {
                    "type": "string",
                    "pattern": "^https?://[^\\s]+$"
                  },
                  "tokenUrl": {
                    "type": "string",
                    "pattern": "^https?://[^\\s]+$"
                  },
                  "userInfoUrl": {
                    "type": "string",
                    "pattern": "^https?://[^\\s]+$"
                  },
                  "jwksUrl": {
                    "type": "string",
                    "pattern": "^https?://[^\\s]+$"
                  },
                  "algorithms": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false,
                "required": [
                  "issuerUrl",
                  "authUrl",
                  "tokenUrl",
                  "jwksUrl"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "existingSecret"
            ],
            "allOf": [
              {
                "oneOf": [
                  {
                    "required": [
                      "clientId"
                    ],
                    "not": {
                      "required": [
                        "clientIdKey"
                      ]
                    }
                  },
                  {
                    "required": [
                      "clientIdKey"
                    ],
                    "not": {
                      "required": [
                        "clientId"
                      ]
                    }
                  }
                ]
              },
              {
                "oneOf": [
                  {
                    "required": [
                      "providerUrl"
                    ],
                    "not": {
                      "required": [
                        "endpoint"
                      ]
                    }
                  },
                  {
                    "required": [
                      "endpoint"
                    ],
                    "not": {
                      "required": [
                        "providerUrl"
                      ]
                    }
                  }
                ]
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "enable": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "providers": {
                "minProperties": 1
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "secrets"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "if": {
        "properties": {
          "oidc": {
            "properties": {
              "enable": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "general": {
            "properties": {
              "host": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
