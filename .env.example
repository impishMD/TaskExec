# For published images; local development uses compose.dev.yaml and taskexec:dev.
TASKEXEC_VERSION=v1.1.2
TASKEXEC_IMAGE=impishmd/taskexec
TASKEXEC_BIND_ADDRESS=127.0.0.1
TASKEXEC_ADMIN=admin
TASKEXEC_ADMIN_NAME=Administrator
TASKEXEC_ADMIN_EMAIL=admin@localhost
TASKEXEC_ADMIN_PASSWORD=
# Generate once: openssl rand -base64 32. Keep the key with your backups.
TASKEXEC_ACCESS_KEY_ENCRYPTION=
