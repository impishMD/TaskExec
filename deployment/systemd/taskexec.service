[Unit]
Description=TaskExec
Documentation=https://github.com/impishMD/TaskExec
Wants=network-online.target
After=network-online.target

[Service]
User=taskexec
Group=taskexec
StateDirectory=taskexec
WorkingDirectory=/var/lib/taskexec
EnvironmentFile=-/etc/taskexec/env
ExecStart=/usr/bin/taskexec server --config /etc/taskexec/config.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
